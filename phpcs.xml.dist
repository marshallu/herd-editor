<?xml version="1.0"?>
<ruleset name="Herd Editor">
    <description>
        WordPress and VIP coding standards for Herd Editor.

        The formatting families below are excluded rather than fixed. This
        codebase has a consistent house style that differs from WPCS on array
        alignment, multi-line call layout and block-comment spacing, and
        reformatting ~650 findings would rewrite nearly every file without
        changing what any of it does. What is enforced is everything that can
        be wrong rather than merely different: security, escaping, VIP's
        restricted functions, and correctness.
    </description>

    <rule ref="WordPress">
        <!-- House style: alignment and multi-line layout. -->
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
        <exclude name="WordPress.Arrays.ArrayIndentation"/>
        <exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
        <exclude name="NormalizedArrays.Arrays.CommaAfterLast"/>
        <exclude name="PEAR.Functions.FunctionCallSignature"/>
        <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
        <exclude name="Squiz.ControlStructures.ControlSignature"/>
        <exclude name="Squiz.Commenting.BlockComment"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
        <exclude name="Squiz.PHP.EmbeddedPhp"/>
        <exclude name="Generic.Formatting.DisallowMultipleStatements"/>

        <!-- Yoda conditions are a style preference, not a correctness one. -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!--
            The plugin documents itself in prose above each function rather than
            in @param tables. Enforcing the tags would add noise, not meaning.
        -->
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Generic.Commenting.DocComment.LongNotCapital"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>

        <!--
            Local variables that happen to share a name with a WordPress global
            ($post, $order, $errors) inside a function are not globals.
        -->
        <exclude name="WordPress.WP.GlobalVariablesOverride"/>
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound"/>
    </rule>

    <rule ref="WordPress-VIP-Go"/>

    <file>.</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <!--
        WP-CLI verification and migration scripts. Run by hand by a developer,
        never loaded by WordPress, and never deployed as runtime code.
    -->
    <exclude-pattern>tools/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs-cache"/>

    <config name="minimum_wp_version" value="6.5"/>
    <config name="testVersion" value="8.2-"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="herd-editor"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="herd_editor"/>
                <element value="HERD_EDITOR"/>
                <element value="Herd_Editor"/>
            </property>
        </properties>
    </rule>
</ruleset>
